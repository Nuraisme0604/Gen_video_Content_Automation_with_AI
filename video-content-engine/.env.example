# ============================================================
# CONTENT ENGINE - GENERIC CHANNEL CONFIGURATION
# Copy to .env and fill in your actual values
# ============================================================

# === CORE PIPELINE ===
NODE_ENV=production
# draft | semi-auto | full-auto
PIPELINE_MODE=draft
ASSETS_DIR=/assets_temp
# Số scenes xử lý song song (video dài cần tăng)
MAX_PARALLEL_SCENES=5

# === CHANNEL IDENTITY (configurable per channel) ===
CHANNEL_NAME=My YouTube Channel
# Ví dụ: travel | cooking | finance | self-help | history
CHANNEL_NICHE=general
# URL kênh YouTube tham chiếu (để trống nếu chỉ dùng niche).
# Hỗ trợ format: https://youtube.com/@handle | /channel/UCxxx | /user/xxx
CHANNEL_URL=
CHANNEL_LANGUAGE=English
CHANNEL_VISUAL_STYLE=cinematic, high quality, professional lighting, 16:9 composition
# 15 | 20 | etc.
TARGET_DURATION_MINUTES=15
SCENE_VIDEO_SECONDS=8

# === YouTube Data API (phân tích kênh tham chiếu THẬT, không bịa) ===
# Lấy free tại Google Cloud Console → "Enable APIs & Services" → "YouTube Data API v3" → API key
# Nếu để trống, GPT sẽ generate topic chỉ dựa trên CHANNEL_NICHE (không phân tích kênh thật)
YOUTUBE_DATA_API_KEY=

# === OpenAI (Script + Image) ===
OPENAI_API_KEY=sk-...
# Text models (latest April 2026):
#   gpt-5.4-mini   — RECOMMENDED. $0.75/M input, $4.5/M output, 400K context, fast
#   gpt-5.5        — Premium ($5/M input, $30/M output). Dùng cho QA/refine nếu cần chất lượng tối đa
#   gpt-5.4        — Mid-tier
# Lưu ý: gpt-4.1-mini đã CŨ, gpt-5.x series ra từ Q1/2026.
OPENAI_TEXT_MODEL=gpt-5.4-mini
# Image models (latest April 2026):
#   gpt-image-2    — RECOMMENDED. Released 21/4/2026. Reasoning, 99% text accuracy, supports up to 4K.
#   gpt-image-1.5  — Mid-tier
#   gpt-image-1    — Backup nếu org chưa verified cho image-2
OPENAI_IMAGE_MODEL=gpt-image-2

# === Anthropic Claude (Script Refinement) ===
ANTHROPIC_API_KEY=sk-ant-...
# Latest Claude family (April 2026):
#   claude-opus-4-7    — RECOMMENDED. Newest, best for creative scriptwriting & retention optimization.
#   claude-sonnet-4-6  — Mid-tier, ~5x rẻ hơn Opus, vẫn tốt cho refine
#   claude-haiku-4-5-20251001 — Fastest/cheapest, dùng nếu chỉ cần grammar polish
CLAUDE_MODEL=claude-opus-4-7

# === ElevenLabs (Voiceover) ===
ELEVENLABS_API_KEY=...
ELEVENLABS_VOICE_ID=...
ELEVENLABS_MODEL=eleven_multilingual_v2

# === Video Generation - chọn 1 provider ===
# veo3 | runway
VIDEO_PROVIDER=veo3
# Runway key (chỉ cần nếu VIDEO_PROVIDER=runway)
VIDEO_API_KEY=
VIDEO_API_URL=https://api.dev.runwayml.com/v1/text_to_video
VIDEO_MODEL=gen4_turbo

# === Google Veo3 (nếu VIDEO_PROVIDER=veo3) ===
GOOGLE_API_KEY=AIza...
# Models hợp lệ (Gemini API):
#   veo-3.1-generate-preview (mới nhất, recommended)
#   veo-3.1-fast-generate-preview (rẻ hơn, nhanh hơn)
# Lưu ý: veo-3.0-generate-preview đã DEPRECATED từ April 2026 → DO NOT USE
VEO3_MODEL=veo-3.1-generate-preview
# Giây tối đa chờ 1 clip
VEO3_POLL_TIMEOUT=300

# === Image-to-Video (CRITICAL cho visual continuity) ===
# true (default): Pass DALL-E scene image vào Veo3 làm initial frame.
#   → video gen sẽ continue từ ảnh DALL-E thay vì generate hoàn toàn mới
#   → visual giữa scene image và scene video khớp nhau
# false: Veo3 generate từ text prompt only (visual có thể không khớp DALL-E)
USE_IMAGE_TO_VIDEO=true

# === Music - chọn 1 provider ===
# elevenlabs (RECOMMENDED, official, dùng cùng ELEVENLABS_API_KEY)
# suno       (DEPRECATED — Suno chưa có public API, studio-api.suno.ai là reverse-engineered)
# static     (skip AI, dùng BGM_FALLBACK_URL)
MUSIC_PROVIDER=elevenlabs

# BGM_PROMPT là FALLBACK khi topic không có core_emotion. Workflow 01 sẽ generate
# core_emotion (vd: "melancholic", "tense", "uplifting") → worker override prompt để
# mỗi video có nhạc đúng vibe.
BGM_PROMPT=calm ambient background music, emotional, no vocals, documentary style

# === ElevenLabs Music (nếu MUSIC_PROVIDER=elevenlabs) ===
# Yêu cầu paid plan. Dùng cùng ELEVENLABS_API_KEY ở section voiceover.
# Endpoint: POST https://api.elevenlabs.io/v1/music
ELEVENLABS_MUSIC_MODEL=music_v1
# BGM_DURATION_MS:
#   = 0 (default): worker tự tính theo video length (≈ scenes × scene_seconds × 1.1, cap 600s)
#   > 0: override fixed duration. API cho phép 3000-600000 ms (3s-10min).
# Video > 10 phút sẽ được loop với crossfade tự động trong video_assembler.
BGM_DURATION_MS=0

# === Suno AI (LEGACY — chỉ dùng nếu bạn đã có Suno cookie/API key qua 3rd-party gateway) ===
# Suno KHÔNG có official API. studio-api.suno.ai là reverse-engineered endpoint.
# Có thể vi phạm Suno ToS. Dùng ElevenLabs Music thay thế nếu có thể.
SUNO_API_KEY=
SUNO_MODEL=chirp-v3-5
# Override nếu dùng 3rd-party gateway (vd: https://api.sunoapi.org, https://suno.gcui.ai)
SUNO_API_BASE=https://studio-api.suno.ai

# Fallback BGM static (mp3 URL public). Nếu provider trên fail và URL này cũng fail → video không có nhạc.
BGM_FALLBACK_URL=https://github.com/rafaelreis-hotmart/Audio-Sample-files/raw/master/sample.mp3

# === Audio Mix Levels (final video) ===
# Veo 3 native audio (ambient + SFX + dialogue tự gen). 0.0 = disable, 0.3 = 30% subtle background
VEO_AUDIO_VOLUME=0.3
# ElevenLabs voiceover (narration). 1.0 = 100% (dominant)
VOICE_VOLUME=1.0
# BGM ducking volume. 0.15 = 15% — không đè narration
BGM_VOLUME=0.15
# Crossfade fadein/fadeout khi BGM loop. Set 0 để disable.
BGM_CROSSFADE_SEC=2.0

# === YouTube Upload ===
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Lấy từ OAuth2 playground (developers.google.com/oauthplayground)
YOUTUBE_REFRESH_TOKEN=
# private | unlisted | public
YOUTUBE_PRIVACY_STATUS=private
# 22 = People & Blogs (xem https://developers.google.com/youtube/v3/docs/videoCategories/list)
YOUTUBE_CATEGORY_ID=22

# === TikTok ===
# LƯU Ý: Code worker hiện chỉ TẠO clip 9:16 (cropped + hardsub) ở local —
# CHƯA có code upload tự động lên TikTok. Nếu cần auto-upload, bạn phải tự
# thêm integration với TikTok Content Posting API (https://developers.tiktok.com/doc/content-posting-api-get-started).
# Để trống các biến dưới đây cho đến khi có integration.

# === Subtitles ===
# Nếu true → burn-in subtitle trực tiếp vào master video (cần cho TikTok/Shorts).
# Nếu false → chỉ tạo file .srt riêng (YouTube tự nhận làm closed caption).
BURN_SUBTITLES=false
# Tuỳ chỉnh style burn-in (ASS format). Để trống dùng default trắng + viền đen.
# SUBTITLE_STYLE=FontName=Arial,FontSize=24,PrimaryColour=&Hffffff,OutlineColour=&H000000,BorderStyle=1,Outline=2,Alignment=2,MarginV=40
SUBTITLE_STYLE=

# === Quality Control ===
MIN_QA_SCORE=75
# USD
BUDGET_LIMIT_PER_VIDEO=100

# === Database ===
DATABASE_URL=postgresql://user:pass@postgres:5432/content_engine
POSTGRES_USER=user
POSTGRES_PASSWORD=pass
POSTGRES_DB=content_engine

# === Notifications ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
