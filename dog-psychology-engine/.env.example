# ============================================================
# CONTENT ENGINE - GENERIC CHANNEL CONFIGURATION
# Copy to .env and fill in your actual values
# ============================================================

# === CORE PIPELINE ===
NODE_ENV=production
PIPELINE_MODE=draft              # draft | semi-auto | full-auto
ASSETS_DIR=/assets_temp
MAX_PARALLEL_SCENES=5            # Số scenes xử lý song song (video dài cần tăng)

# === CHANNEL IDENTITY (configurable per channel) ===
CHANNEL_NAME=My YouTube Channel
CHANNEL_NICHE=general            # Ví dụ: dog psychology | cooking | finance | travel
CHANNEL_URL=                     # URL kênh YouTube để phân tích (để trống nếu dùng niche)
CHANNEL_LANGUAGE=English
CHANNEL_VISUAL_STYLE=cinematic, high quality, professional lighting, 16:9 composition
TARGET_DURATION_MINUTES=15       # 15 | 20 | etc.
SCENE_VIDEO_SECONDS=8

# === OpenAI (Script + Image) ===
OPENAI_API_KEY=sk-...
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-2

# === Anthropic Claude (Script Refinement) ===
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-6

# === ElevenLabs (Voiceover) ===
ELEVENLABS_API_KEY=...
ELEVENLABS_VOICE_ID=...
ELEVENLABS_MODEL=eleven_multilingual_v2

# === Video Generation - chọn 1 provider ===
VIDEO_PROVIDER=veo3              # veo3 | runway
VIDEO_API_KEY=                   # Runway key (nếu dùng runway)
VIDEO_API_URL=https://api.dev.runwayml.com/v1/text_to_video
VIDEO_MODEL=gen4_turbo

# === Google Veo3 (nếu VIDEO_PROVIDER=veo3) ===
GOOGLE_API_KEY=AIza...
VEO3_MODEL=veo-3.0-generate-preview
VEO3_POLL_TIMEOUT=300            # Giây tối đa chờ 1 clip

# === Music - chọn 1 provider ===
MUSIC_PROVIDER=suno              # suno | static
BGM_PROMPT=calm ambient background music, emotional, no vocals, documentary style

# === Suno AI (nếu MUSIC_PROVIDER=suno) ===
SUNO_API_KEY=...
SUNO_MODEL=chirp-v3-5

# === YouTube Upload ===
YOUTUBE_CLIENT_ID=...
YOUTUBE_CLIENT_SECRET=...
YOUTUBE_REFRESH_TOKEN=           # Lấy từ OAuth2 playground
YOUTUBE_PRIVACY_STATUS=private   # private | unlisted | public
YOUTUBE_CATEGORY_ID=22           # 22 = People & Blogs

# === TikTok (optional) ===
TIKTOK_ACCESS_TOKEN=
TIKTOK_ENABLED=false

# === Quality Control ===
MIN_QA_SCORE=75
BUDGET_LIMIT_PER_VIDEO=100       # USD

# === Database ===
DATABASE_URL=postgresql://user:pass@postgres:5432/content_engine
POSTGRES_USER=user
POSTGRES_PASSWORD=pass
POSTGRES_DB=content_engine

# === Notifications ===
TELEGRAM_BOT_TOKEN=...
TELEGRAM_CHAT_ID=...
