# === CORE ===
NODE_ENV=production
PIPELINE_MODE=draft          # draft | semi-auto | full-auto
ASSETS_DIR=/assets_temp      # Đường dẫn tuyệt đối trong Docker container

# === OpenAI ===
OPENAI_API_KEY=sk-...
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-2

# === ElevenLabs ===  
ELEVENLABS_API_KEY=...
ELEVENLABS_VOICE_ID=...
ELEVENLABS_MODEL=eleven_multilingual_v2

# === Video Generation ===
VIDEO_PROVIDER=runway        # runway | kling | fal
VIDEO_API_URL=https://api.runwayml.com/v1
VIDEO_API_KEY=...
VIDEO_MODEL=gen4_turbo
SCENE_VIDEO_SECONDS=8
VIDEO_CONCURRENT_LIMIT=3     # Giới hạn gọi API song song

# === YouTube ===
YOUTUBE_CLIENT_ID=...
YOUTUBE_CLIENT_SECRET=...
YOUTUBE_REFRESH_TOKEN=...
YOUTUBE_PRIVACY_STATUS=private

# === TikTok ===
TIKTOK_ACCESS_TOKEN=...
TIKTOK_ENABLED=false

# === Quality Control ===
MIN_QA_SCORE=75
BUDGET_LIMIT_PER_VIDEO=100   # USD

# === Database ===
DATABASE_URL=postgresql://user:pass@postgres:5432/dog_engine

# === Notification ===
TELEGRAM_BOT_TOKEN=...
TELEGRAM_CHAT_ID=...

# === Notifications ===
TELEGRAM_BOT_TOKEN=...
TELEGRAM_CHAT_ID=...
