{
  "name": "03 - Render Complete & Notify",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "render-complete",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "c3000001-0000-0000-0000-000000000001",
      "name": "Webhook - Render Complete",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 200],
      "webhookId": "render-complete-webhook"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const body = $input.first().json.body || $input.first().json;\nconst video_id = body.video_id || 'unknown';\nconst title = body.title || 'Unknown Video';\nconst youtube_url = body.youtube_url || '';\nconst cost_usd = body.cost_usd || 0;\n\nconst status_emoji = youtube_url ? '✅' : '⚠️';\nconst yt_line = youtube_url ? `\\n📺 <b>YouTube:</b> ${youtube_url}` : '\\n⚠️ YouTube upload not configured';\n\nconst message = `${status_emoji} <b>VIDEO COMPLETE</b>\\n\\n🎬 <b>Title:</b> ${title}\\n🆔 <b>Episode:</b> ${video_id}\\n💰 <b>Cost:</b> $${parseFloat(cost_usd).toFixed(2)}${yt_line}`;\n\nreturn [{ json: { video_id, title, youtube_url, cost_usd, message } }];"
      },
      "id": "c3000002-0000-0000-0000-000000000002",
      "name": "Code - Build Notification",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [240, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{$env.TELEGRAM_BOT_TOKEN}}/sendMessage",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "Content-Type", "value": "application/json" }]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chat_id: $env.TELEGRAM_CHAT_ID, text: $json.message, parse_mode: 'HTML' }) }}",
        "options": {}
      },
      "id": "c3000003-0000-0000-0000-000000000003",
      "name": "HTTP - Telegram Notify",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 80]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=UPDATE videos SET status = 'published' WHERE id = '{{ $json.video_id }}' AND status = 'uploaded';"
      },
      "id": "c3000004-0000-0000-0000-000000000004",
      "name": "Postgres - Mark Published",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [480, 320],
      "credentials": { "postgres": { "name": "Postgres" } }
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { status: 'notified', video_id: $('Code - Build Notification').first().json.video_id } }];"
      },
      "id": "c3000005-0000-0000-0000-000000000005",
      "name": "Code - Done",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [720, 200]
    }
  ],
  "pinData": {},
  "connections": {
    "Webhook - Render Complete": { "main": [[{ "node": "Code - Build Notification", "type": "main", "index": 0 }]] },
    "Code - Build Notification": {
      "main": [[
        { "node": "HTTP - Telegram Notify", "type": "main", "index": 0 },
        { "node": "Postgres - Mark Published", "type": "main", "index": 0 }
      ]]
    },
    "HTTP - Telegram Notify": { "main": [[{ "node": "Code - Done", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Ho_Chi_Minh",
    "saveManualExecutions": true
  },
  "meta": {
    "description": "Called by Python worker when pipeline finishes. Sends Telegram notification and marks video as published in DB."
  },
  "tags": ["youtube", "notification", "completion"]
}
