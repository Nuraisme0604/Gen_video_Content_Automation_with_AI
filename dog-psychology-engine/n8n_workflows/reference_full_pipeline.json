        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: $env.OPENAI_TEXT_MODEL || 'gpt-4.1-mini', input: [ { role: 'system', content: 'You are a senior YouTube strategist for emotional dog psychology storytelling channels. Return valid JSON only.' }, { role: 'user', content: `Create one high-retention video topic package for ${$json.channel_name}. Requirements: niche dog psychology + emotional storytelling + cinematic nature/ancient beauty. Output JSON keys: title, vietnamese_title, core_emotion, dog_behavior_lesson, audience_promise, thumbnail_text, seo_keywords, 3 alternate_titles, why_now, story_seed.` } ], text: { format: { type: 'json_object' } } }) }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "a2257e83-2ec2-46b7-867f-dfedb4ca58e7",
      "name": "AI - Generate Topic Package",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        520,
        80
      ]
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.output_text || $input.first().json.text || JSON.stringify($input.first().json);\nlet obj;\ntry { obj = JSON.parse(raw); } catch(e) { obj = $input.first().json; }\nreturn [{ json: { ...$('Channel Config').first().json, topic: obj } }];"
      },
      "id": "aaacf081-2981-4b06-8f26-7bf15c862842",
      "name": "Code - Parse Topic JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        760,
        80
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/responses",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.OPENAI_API_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: $env.OPENAI_TEXT_MODEL || 'gpt-4.1-mini', input: [ { role: 'system', content: 'You are an elite long-form YouTube scriptwriter. Write emotional cinematic dog stories with psychological insight. Return valid JSON only.' }, { role: 'user', content: `Write an 18-minute English narration script for this topic package:\n${JSON.stringify($json.topic)}\n\nRequired structure: ${$json.video_structure}. Keep narration suitable for voiceover. Output JSON keys: title, narration_script, hook, build_tension, twist_climax, emotional_ending, cta, safety_note, estimated_words.` } ], text: { format: { type: 'json_object' } } }) }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "f15b5a67-c468-4a8e-96fd-c7308834502d",
      "name": "AI - Write 18 Minute Script",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1000,
        80
      ]
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.output_text || $input.first().json.text || JSON.stringify($input.first().json);\nlet script;\ntry { script = JSON.parse(raw); } catch(e) { script = { narration_script: raw, title: $('Code - Parse Topic JSON').first().json.topic?.title || 'Dog Psychology Story' }; }\nconst base = $('Code - Parse Topic JSON').first().json;\nreturn [{ json: { ...base, script } }];"
      },
      "id": "479ac9ef-bc3b-4554-8e20-214d37c1ec0a",
      "name": "Code - Parse Script JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1240,
        80
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/responses",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.OPENAI_API_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: $env.OPENAI_TEXT_MODEL || 'gpt-4.1-mini', input: [ { role: 'system', content: 'You are a YouTube retention editor. Return valid JSON only.' }, { role: 'user', content: `Review this script for retention, emotional clarity, dog psychology accuracy, and YouTube suitability. Return JSON: score_0_100, keep, issues, fixes. Script:\n${$json.script.narration_script}` } ], text: { format: { type: 'json_object' } } }) }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "c49fa359-a97d-426e-b505-d575dedb5622",
      "name": "AI - QA Script Before Production",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1480,
        -100
      ]
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.output_text || '{}';\nlet qa = {}; try { qa = JSON.parse(raw); } catch(e) {}\nconst base = $('Code - Parse Script JSON').first().json;\nif ((qa.score_0_100 || 0) < Number($env.MIN_QA_SCORE || 75)) {\n  throw new Error('Script QA score too low: ' + JSON.stringify(qa));\n}\nreturn [{ json: { ...base, qa } }];"
      },
      "id": "2d64cc2d-5912-4a68-a143-633390d34137",
      "name": "Code - QA Gate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1720,
        -100
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/responses",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.OPENAI_API_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: $env.OPENAI_TEXT_MODEL || 'gpt-4.1-mini', input: [ { role: 'system', content: 'You are an AI video director. Return valid JSON only.' }, { role: 'user', content: `Break this narration into cinematic scenes of about ${$json.scene_seconds} seconds. For each scene create: scene_id, start_sec, end_sec, narration_excerpt, image_prompt, video_prompt, camera_motion, sound_design, negative_prompt. Keep a consistent dog character and emotional arc. Style: ${$json.visual_style}. Return JSON keys: main_character, style_bible, scenes. Script:\n${$json.script.narration_script}` } ], text: { format: { type: 'json_object' } } }) }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "b7fa849c-ba7d-4340-b7c6-afa38b1d6d9a",
      "name": "AI - Scene Breakdown + Prompts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1480,
        160
      ]
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.output_text || '{}';\nlet plan; try { plan = JSON.parse(raw); } catch(e) { throw new Error('Cannot parse scene plan: ' + raw.slice(0,500)); }\nconst base = $('Code - Parse Script JSON').first().json;\nreturn [{ json: { ...base, scene_plan: plan, scenes_count: (plan.scenes || []).length } }];"
      },
      "id": "8a17c3e6-366d-4bbc-9738-0348fc20a24b",
      "name": "Code - Parse Scenes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1720,
        160
      ]
    },
    {
      "parameters": {
        "jsCode": "const base = $input.first().json;\nconst scenes = base.scene_plan.scenes || [];\nreturn scenes.map(scene => ({ json: { episode_id: base.episode_id, workspace: base.workspace, title: base.script.title, style_bible: base.scene_plan.style_bible, main_character: base.scene_plan.main_character, scene } }));"
      },
      "id": "de7e0831-b700-4ac7-8179-75f8fef32b4a",
      "name": "Code - Split Scenes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1960,
        160
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/images/generations",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.OPENAI_API_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: $env.OPENAI_IMAGE_MODEL || 'gpt-image-2', prompt: `${$json.style_bible}\nMain character: ${$json.main_character}\nScene ${$json.scene.scene_id}: ${$json.scene.image_prompt}\nNegative: ${$json.scene.negative_prompt}\nOutput: cinematic 16:9, no text, no watermark.`, size: '1792x1024' }) }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "4450df98-0fdd-469a-9420-485858db0294",
      "name": "HTTP - Generate Scene Image (OpenAI)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2200,
        160
      ]
    },
    {
      "parameters": {
        "jsCode": "const original = $('Code - Split Scenes').all()[$itemIndex]?.json || {};\nconst img = $input.first().json;\nconst url = img.data?.[0]?.url || img.data?.[0]?.b64_json || null;\nreturn [{ json: { ...original, image_result: img, image_url_or_b64: url } }];"
      },
      "id": "bff0fc51-3fd4-4b7f-b995-1cf3cec7c3c4",
      "name": "Code - Normalize Image Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2440,
        160
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.VIDEO_API_URL || 'https://api.dev.runwayml.com/v1/text_to_video'}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.VIDEO_API_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "X-Runway-Version",
              "value": "2024-11-06"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: $env.VIDEO_MODEL || 'gen4_turbo', prompt_text: `${$json.scene.video_prompt}\nCamera: ${$json.scene.camera_motion}\nStyle: ${$json.style_bible}`, duration: Number($env.SCENE_VIDEO_SECONDS || 8), ratio: '16:9', seed_image: $json.image_url_or_b64 }) }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "f66b64dc-dac1-4937-a4dc-32b03cf4a650",
