      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2680,
        160
      ]
    },
    {
      "parameters": {
        "jsCode": "const sceneItem = $('Code - Normalize Image Result').all()[$itemIndex]?.json || {};\nconst task = $input.first().json;\nreturn [{ json: { ...sceneItem, video_task: task, video_url: task.output?.[0] || task.video_url || task.url || null, task_id: task.id || task.task_id || null } }];"
      },
      "id": "528ca402-8be9-4a8e-9ed0-f60957c940cb",
      "name": "Code - Normalize Video Task",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2920,
        160
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all().map(i => i.json);\nconst base = $('Code - Parse Script JSON').first().json;\nreturn [{ json: { episode_id: base.episode_id, workspace: base.workspace, title: base.script.title, narration_script: base.script.narration_script, thumbnail_text: base.topic.thumbnail_text, seo_keywords: base.topic.seo_keywords, scenes: items.map(i => ({ scene_id: i.scene.scene_id, start_sec: i.scene.start_sec, end_sec: i.scene.end_sec, narration_excerpt: i.scene.narration_excerpt, image: i.image_url_or_b64, video_url: i.video_url, task_id: i.task_id, sound_design: i.scene.sound_design })) } }];"
      },
      "id": "c49b6378-6efb-4aff-abb4-f6951da20b28",
      "name": "Code - Build Render Manifest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3160,
        160
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.elevenlabs.io/v1/text-to-speech/{{$env.ELEVENLABS_VOICE_ID}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "xi-api-key",
              "value": "={{$env.ELEVENLABS_API_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Accept",
              "value": "audio/mpeg"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: $json.script.narration_script, model_id: $env.ELEVENLABS_MODEL || 'eleven_multilingual_v2', voice_settings: { stability: 0.45, similarity_boost: 0.85, style: 0.35, use_speaker_boost: true } }) }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "voiceover_mp3"
            }
          }
        }
      },
      "id": "bf15cfd5-f94f-48b3-a05e-6898e6b7d3dd",
      "name": "HTTP - Generate Voiceover (ElevenLabs)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1480,
        420
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/responses",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.OPENAI_API_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: $env.OPENAI_TEXT_MODEL || 'gpt-4.1-mini', input: [ { role: 'system', content: 'You are a YouTube SEO strategist. Return valid JSON only.' }, { role: 'user', content: `Create upload metadata for this video. Title: ${$json.title}. Keywords: ${JSON.stringify($json.seo_keywords)}. Return JSON keys: final_title, description, tags, chapters, pinned_comment, shorts_hook.` } ], text: { format: { type: 'json_object' } } }) }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "fa1387a0-3012-4c6f-a96c-7ca68f3e4c30",
      "name": "HTTP - Generate SEO Metadata",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        3400,
        160
      ]
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.output_text || '{}';\nlet seo; try { seo = JSON.parse(raw); } catch(e) { seo = {}; }\nconst manifest = $('Code - Build Render Manifest').first().json;\nreturn [{ json: { ...manifest, seo } }];"
      },
      "id": "8aa432d1-1474-48c7-b860-2f487a001b6e",
      "name": "Code - Parse SEO Metadata",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3640,
        160
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/images/generations",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.OPENAI_API_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: $env.OPENAI_IMAGE_MODEL || 'gpt-image-2', prompt: `YouTube thumbnail, emotional cinematic dog psychology story. Big expressive dog face, human emotion, dramatic warm lighting, ancient town/nature background. Leave clear empty space for text: ${$json.thumbnail_text}. No watermark.`, size: '1792x1024' }) }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "20be6202-a732-42a2-905d-85a55a30b92f",
      "name": "HTTP - Generate Thumbnail Image",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        3880,
        -80
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.RENDER_API_URL || 'https://api.shotstack.io/edit/stage/render'}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{$env.RENDER_API_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ timeline: { background: '#000000', tracks: [ { clips: $json.scenes.map((s, idx) => ({ asset: { type: 'video', src: s.video_url || s.image }, start: idx * Number($env.SCENE_VIDEO_SECONDS || 8), length: Number($env.SCENE_VIDEO_SECONDS || 8), transition: { in: 'fade', out: 'fade' } })) } ] }, output: { format: 'mp4', resolution: '1080' }, metadata: { episode_id: $json.episode_id, title: $json.title } }) }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "58b39316-8e84-409b-b6f0-7e3ed65a518a",
      "name": "HTTP - Render Final Video Placeholder",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        3880,
        160
      ]
    },
    {
      "parameters": {
        "jsCode": "const meta = $('Code - Parse SEO Metadata').first().json;\nconst render = $input.first().json;\nreturn [{ json: { ...meta, render_result: render, video_download_url: render.response?.url || render.url || render.output?.url || null, youtube_status: $env.YOUTUBE_PRIVACY_STATUS || 'private' } }];"
      },
      "id": "4fbb729a-5a4a-43bd-9d90-06575c1db16e",
      "name": "Code - Prepare YouTube Draft Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4120,
        160
      ]
    },
    {
      "parameters": {
        "resource": "video",
        "operation": "upload",
        "title": "={{$json.seo.final_title || $json.title}}",
        "description": "={{$json.seo.description || ''}}",
        "privacyStatus": "={{$json.youtube_status}}",
        "additionalFields": {
          "tags": "={{($json.seo.tags || []).join(',')}}"
