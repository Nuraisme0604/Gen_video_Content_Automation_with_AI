# ──────────────────────────────────────────────────────────────────────
# AI Video Tool — Environment Configuration
#
# QUAN TRỌNG: File này CHỈ chứa cấu hình hạ tầng (DB, MinIO, ports).
# Tất cả API key (Gemini, OpenAI, Anthropic, ElevenLabs, Runway, ...) được
# quản lý qua UI tại http://localhost:3000/api-sources sau khi stack chạy.
# Key được mã hoá AES-256-GCM trong DB, có thể rotate, không lộ ra Git.
#
# Setup trên máy mới:
#   1. cp .env.example .env
#   2. docker compose up -d
#   3. Mở http://localhost:3000/api-sources → Thêm key Gemini/OpenAI/...
#   4. Tạo project → render video
# ──────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────
POSTGRES_USER=user
POSTGRES_PASSWORD=change_me_db_password
POSTGRES_DB=content_engine
DATABASE_URL=postgresql://user:change_me_db_password@postgres:5432/content_engine

# ── Redis (BullMQ) ────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── MinIO (S3-compatible, asset storage) ──────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio_password
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change_me_minio_password
S3_BUCKET_ASSETS=assets
S3_BUCKET_PUBLIC=public-thumbnails

# ── Backend (NestJS) ──────────────────────────────────────
PORT=3001
FRONTEND_URL=http://localhost:3000
WEBHOOK_HMAC_SECRET=change_me_random_hmac_secret
# ENCRYPTION_SECRET phải đúng 32 chars — dùng để mã hoá API key trong DB.
# Đổi giá trị này = mọi key đã lưu sẽ KHÔNG decrypt được. Cẩn thận khi rotate.
ENCRYPTION_SECRET=change_me_32_chars_exactly_here!!
# Internal secret để n8n + worker gọi BE lookup key. Tránh để cùng giá trị
# với HMAC trên — đổi thành chuỗi random khi deploy production.
INTERNAL_API_SECRET=dev-internal-secret

# ── Frontend (Next.js) ────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# ── n8n & inter-service URLs ──────────────────────────────
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_BASE_URL=http://n8n:5678
BACKEND_URL=http://backend:3001
# Tự gọi callback n8n sau khi worker xong (chỉ bật nếu đã import workflow 03)
ENABLE_N8N_RENDER_CALLBACK=false

# ── Pipeline defaults ─────────────────────────────────────
# slideshow (free, mặc định) | pexels-video (free) | veo3 (paid) | runway (paid)
VIDEO_PROVIDER=slideshow
SCENE_VIDEO_SECONDS=8
MAX_PARALLEL_SCENES=5
PIPELINE_MODE=draft

# ── GCP / Veo3 setup (chỉ cần khi VIDEO_PROVIDER=veo3) ──────
#
# Bước setup (PRE-2 → PRE-4):
#   PRE-2: Bật billing GCP + enable API:
#          https://console.cloud.google.com/apis/library/aiplatform.googleapis.com
#   PRE-3: Tạo Service Account → role "Vertex AI User" → download JSON key
#          → đặt file tại: secrets/gcp-sa.json  (được mount vào /secrets/ trong container)
#   PRE-4: Verify Veo3 access tại:
#          https://console.cloud.google.com/vertex-ai/model-garden (tìm "Veo 3")
#
# Sau khi đặt file key:
#   Đổi VIDEO_PROVIDER=veo3 ở trên rồi: docker compose up -d python_worker
#
# GOOGLE_APPLICATION_CREDENTIALS đã được set mặc định thành /secrets/gcp-sa.json
# trong docker-compose.yml — chỉ override nếu đặt key ở path khác.
# GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcp-sa.json
#
# VEO3_MODEL=veo-3.1-generate-preview
# VEO3_POLL_TIMEOUT=300
# USE_IMAGE_TO_VIDEO=true

# ── Voice (Edge TTS — free, không cần key) ────────────────
VOICE_NAME=vi-VN-NamMinhNeural

# ── Channel metadata (cho video output) ──────────────────
CHANNEL_NAME=My Channel
CHANNEL_NICHE=general
CHANNEL_LANGUAGE=vi
CHANNEL_VISUAL_STYLE=cinematic, 16:9
TARGET_DURATION_MINUTES=10

# ── Audio mix levels ──────────────────────────────────────
VOICE_VOLUME=1.0
BGM_VOLUME=0.15
BGM_CROSSFADE_SEC=2.0
BGM_FALLBACK_URL=https://github.com/rafaelreis-hotmart/Audio-Sample-files/raw/master/sample.mp3

# ── Subtitles ─────────────────────────────────────────────
BURN_SUBTITLES=false

# ──────────────────────────────────────────────────────────
# ❌ KHÔNG đặt API key ở đây — dùng UI /api-sources thay vì .env
# ──────────────────────────────────────────────────────────
# Nếu bạn THẬT SỰ cần override (CI/CD, headless deployment), uncomment:
# OPENAI_API_KEY=...
# ELEVENLABS_API_KEY=...
# Nhưng sẽ KHÔNG được rotate tự động, KHÔNG mã hoá, KHÔNG share giữa users.
